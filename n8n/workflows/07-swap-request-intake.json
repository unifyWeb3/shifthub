{
  "name": "ShiftHub — 07 · Swap Request Intake",
  "nodes": [
    {
      "parameters": {
        "content": "# ShiftHub — Swap Request Intake\n\nPublic form endpoint (used by the ShiftHub web app on Vercel). Validates the request, writes it to the SwapRequests tab, notifies the supervisor by email + Telegram, and returns JSON.\n\nPOST fields: name, contact, shiftDate, ward, reason, startTime?, endTime?, role?, targetPreference?, assignmentId?, shiftId?",
        "height": 220,
        "width": 400,
        "color": 4
      },
      "id": "f2078c48-ab48-5002-81e1-1fbece07e444",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        60
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "swap-request",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b581b7ac-69bc-4fa4-89f4-f1a63274e08b",
      "name": "Swap Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        160
      ],
      "notes": "HTTP entry point. Point the Vercel app (or curl) at this URL."
    },
    {
      "parameters": {
        "jsCode": "const b = ($input.first().json.body) || {};\nconst s = (k) => String(b[k] ?? '').trim();\nconst missing = ['name','contact','shiftDate','ward','reason'].filter((f) => !s(f));\nconst requestId = 'SWP-' + Date.now().toString(36).toUpperCase() + '-' + Math.floor(Math.random() * 46656).toString(36).toUpperCase().padStart(3, '0');\nreturn [{ json: {\n  requestId, createdAt: new Date().toISOString(),\n  assignmentId: s('assignmentId'), shiftId: s('shiftId'),\n  date: s('shiftDate'), startTime: s('startTime'), endTime: s('endTime'),\n  ward: s('ward'), role: s('role'),\n  requestorName: s('name'), requestorContact: s('contact'),\n  targetPreference: s('targetPreference'), reason: s('reason'),\n  status: 'OPEN', ok: missing.length === 0, missing,\n} }];\n"
      },
      "id": "46936c3c-5b42-4e54-b25e-3d746f2a20a0",
      "name": "Validate Swap Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        160
      ],
      "notes": "Builds the SwapRequests row and flags missing fields."
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "9c769c8a-db6a-4494-b86c-10afe8249f5d",
      "name": "Request Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        160
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "PASTE_GOOGLE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Settings",
          "mode": "name"
        },
        "options": {}
      },
      "id": "ec5205b1-90f5-49da-a248-048889dde0ec",
      "name": "Read Settings",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Why Code: pivot Settings inline and merge with the validated swap item into output fields.\nconst cfgRows = $('Read Settings').all().map((i) => i.json);\nconst cfg = {};\nfor (const r of cfgRows) { const k = String(r.key ?? '').trim(); if (k) cfg[k] = r.value ?? ''; }\nconst swap = $('Validate Swap Request').first().json;\nconst notify = [\n  'Swap request ' + swap.requestId,\n  '',\n  swap.requestorName + ' (' + swap.requestorContact + ') wants to swap a shift:',\n  '- Shift:  ' + swap.date + (swap.startTime ? ' ' + swap.startTime + '-' + swap.endTime : ''),\n  '- Unit:   ' + swap.ward + (swap.role ? '  |  Role: ' + swap.role : ''),\n  '- Reason: ' + swap.reason,\n  '- Preferred partner: ' + (swap.targetPreference || 'Any qualified staff member'),\n  '',\n  'Recorded in the SwapRequests tab. Decide, assign in the rota, then tell both staff members.',\n].join('\\n');\nreturn [{ json: {\n  ...swap,\n  supervisorEmail: cfg.supervisorEmail,\n  supervisorTelegramChatId: cfg.supervisorTelegramChatId,\n  fromEmail: cfg.fromEmail || '',\n  facilityName: cfg.facilityName || 'the facility',\n  notifyText: notify,\n  subject: '[ShiftHub] Swap request ' + swap.requestId + ' - ' + swap.ward + ' ' + swap.date,\n} }];\n"
      },
      "id": "c0f6814a-3d41-4f64-a151-7ed625266863",
      "name": "Prepare Outputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "notes": "Merges the validated request with supervisor contacts from Settings."
    },
