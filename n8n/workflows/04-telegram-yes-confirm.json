        "chatId": "={{ $('Pick Assignment to Confirm').first().json.chatId }}",
        "text": "={{ '✅ ' + $('Pick Assignment to Confirm').first().json.replyText }}"
      },
      "id": "5a6fcb76-227f-40d2-9ca9-e2180ad59bd7",
