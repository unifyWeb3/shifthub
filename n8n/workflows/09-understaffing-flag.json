    {
      "parameters": {
        "jsCode": "// Why Code: one summary alert for the supervisor + one record per understaffed shift for the Flags tab.\nconst cfg = $('Pivot Settings').first().json;\nconst facility = cfg.facilityName || 'the facility';\nconst tz = cfg.timezone || 'Africa/Lagos';\nconst today = DateTime.now().setZone(tz).startOf('day');\nconst horizon = today.plus({ days: 13 });\nconst rows = $('Read Rota').all().map((i) => i.json).filter((r) => {\n  const d = DateTime.fromFormat(String(r.date), 'yyyy-MM-dd', { zone: tz });\n  return d.isValid && d >= today && d <= horizon;\n});\nconst byShift = new Map();\nfor (const r of rows) {\n  if (!byShift.has(r.shiftId)) {\n    byShift.set(r.shiftId, { shiftId: r.shiftId, date: r.date, startTime: r.startTime, ward: r.ward, role: r.role,\n      requiredCount: Number(r.requiredCount) || 1, confirmed: 0 });\n  }\n  if (String(r.status).toUpperCase() === 'CONFIRMED') byShift.get(r.shiftId).confirmed += 1;\n}\nconst under = [...byShift.values()]\n  .map((g) => ({ ...g, missingCount: Math.max(0, g.requiredCount - g.confirmed) }))\n  .filter((g) => g.missingCount > 0)\n  .sort((a, b) => (a.date + a.startTime).localeCompare(b.date + b.startTime));\nif (!under.length) return [];\nconst flaggedAt = DateTime.now().setZone(tz).toISO();\nconst flagRows = under.map((g) => ({ flaggedAt, shiftId: g.shiftId, date: g.date, startTime: g.startTime,\n  ward: g.ward, role: g.role, requiredCount: g.requiredCount, confirmedCount: g.confirmed, missingCount: g.missingCount,\n  message: g.confirmed + '/' + g.requiredCount + ' confirmed - ' + g.missingCount + ' short' }));\nconst lines = under.map((g) =>\n  '- ' + g.shiftId + '  |  ' + g.date + ' ' + g.startTime + '  |  ' + g.ward + '  |  ' + g.role +\n  '  |  ' + g.confirmed + '/' + g.requiredCount + ' confirmed (' + g.missingCount + ' short)');\nconst alertText = [\n  'UNDERSTAFFED SHIFTS - next 14 days',\n  '',\n  'Facility: ' + facility,\n  '',\n].concat(lines).concat([\n  '',\n  'Each row above is flagged in the rota sheet and logged in the Flags tab. Assign cover or escalate now.',\n]).join('\\n');\nreturn [{ json: {\n  understaffed: flagRows, count: under.length, facilityName: facility,\n  supervisorEmail: cfg.supervisorEmail, supervisorTelegramChatId: cfg.supervisorTelegramChatId,\n  alertText,\n  subject: '[ShiftHub] ' + under.length + ' understaffed shift(s) in the next 14 days',\n} }];\n"
      },
