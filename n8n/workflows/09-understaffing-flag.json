      "typeVersion": 4.5,
      "position": [
        220,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "// Why Code: transpose the key|value Settings tab into one object.\nconst rows = $input.all().map((i) => i.json);\nconst cfg = {};\nfor (const r of rows) {\n  const k = String(r.key ?? '').trim();\n  if (k) cfg[k] = r.value ?? '';\n}\nreturn [{ json: cfg }];\n"
      },
      "id": "65674fd0-5648-4477-9218-a151f56e1f5c",
      "name": "Pivot Settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        120
      ],
      "notes": "Pivots key|value rows into a settings object."
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "PASTE_GOOGLE_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Rota",
          "mode": "name"
        },
        "options": {}
      },
      "id": "efda978f-1302-4d8e-959b-8808ed6e252c",
      "name": "Read Rota",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "// Why Code: per-row flags for assignments inside understaffed shifts; Set cannot group.\nconst tz = $('Pivot Settings').first().json.timezone || 'Africa/Lagos';\nconst today = DateTime.now().setZone(tz).startOf('day');\nconst horizon = today.plus({ days: 13 });\nconst rows = $('Read Rota').all().map((i) => i.json).filter((r) => {\n  const d = DateTime.fromFormat(String(r.date), 'yyyy-MM-dd', { zone: tz });\n  return d.isValid && d >= today && d <= horizon;\n});\nconst groups = new Map();\nfor (const r of rows) {\n  if (!groups.has(r.shiftId)) groups.set(r.shiftId, { requiredCount: Number(r.requiredCount) || 1, confirmed: 0, members: [] });\n  const g = groups.get(r.shiftId);\n  g.members.push(r);\n  if (String(r.status).toUpperCase() === 'CONFIRMED') g.confirmed += 1;\n}\nconst out = [];\nfor (const g of groups.values()) {\n  if (g.confirmed >= g.requiredCount) continue;\n  for (const r of g.members) {\n    if (String(r.understaffedFlag || '').toUpperCase() === 'YES') continue;\n    out.push({ json: { assignmentId: r.assignmentId, understaffedFlag: 'YES' } });\n  }\n}\nreturn out;\n"
      },
      "id": "639a68f5-4f7c-45e0-aa28-6936959071ac",
      "name": "Find Understaffed Rows",
      "type": "n8n-nodes-base.code",
