{
  "name": "ShiftHub — 09 · Understaffing Check & Flag",
  "nodes": [
    {
      "parameters": {
        "content": "# ShiftHub — Understaffing Check & Flag\n\nDaily 07:00. Groups the next 14 days of rota rows by shift and compares CONFIRMED headcount against requiredCount.\n\n- Flips understaffedFlag = YES on the affected rota rows\n- Appends one row per short shift to the Flags tab\n- Emails + Telegrams the supervisor the full list",
        "height": 210,
        "width": 400,
        "color": 4
      },
      "id": "3b1ec653-7ef0-5aaa-8da3-154034dd1614",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        60
      ]
    },
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "custom",
              "cronExpression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "767cdee9-c581-48fd-bcf3-b81b40f9b11f",
      "name": "Cron Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
